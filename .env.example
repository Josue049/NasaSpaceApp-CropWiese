# Cropi (asistente con IA) - copia este archivo a .env y completa la clave. NUNCA subas .env al repositorio.
# Obten una clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_OUTPUT_TOKENS=1200
# Opcional (modelos gpt-oss): low | medium | high
# GROQ_REASONING_EFFORT=low
